# ── Copie ce fichier en .env.local et remplis les valeurs ──
# .env.local est gitignoré : tes secrets n'y seront jamais committés.

# Last.fm — clé API gratuite et instantanée : https://www.last.fm/api/account/create
# user.getRecentTracks ne demande AUCUNE authentification (ni OAuth) : juste la clé.
LASTFM_API_KEY=
LASTFM_USER=

# Neon (Postgres) — chaîne de connexion "pooled" du dashboard Neon.
# Format : postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Secret protégeant l'endpoint de cron (/api/cron/sync).
# Génère une valeur aléatoire, et mets la même dans Vercel → Settings → Environment Variables
# ainsi que dans l'en-tête Authorization du Vercel Cron.
CRON_SECRET=

# Fuseau pour les agrégations "par jour". Ne pas changer sans raison.
APP_TZ=Europe/Paris

# ── Connexion Last.fm (OAuth) ──
# Le site est protégé (login obligatoire) dès que AUTH_SECRET est défini.
# En local tu peux le laisser vide (accès ouvert pour développer).
# LASTFM_API_SECRET : le "shared secret" de ton appli Last.fm
#   (https://www.last.fm/api/accounts) — sert à signer auth.getSession.
# AUTH_SECRET       : chaîne aléatoire longue (signe le cookie de session).
# ALLOW_ALL_USERS   : "1" = tout le monde peut se connecter (phase 2, données
#   par utilisateur). Vide/absent = seul ton compte (LASTFM_USER) est autorisé.
LASTFM_API_SECRET=
AUTH_SECRET=
ALLOW_ALL_USERS=
